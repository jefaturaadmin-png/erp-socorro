rules_version = '2';
// Reglas de seguridad de ERP Socorro. Se pegan en Firebase → Firestore Database → Reglas → Publicar.
service cloud.firestore {
  match /databases/{db}/documents {

    function miDoc() { return get(/databases/$(db)/documents/usuarios/$(request.auth.uid)).data; }
    function activo() {
      return request.auth != null
        && exists(/databases/$(db)/documents/usuarios/$(request.auth.uid))
        && miDoc().activo == true;
    }
    function rol(lista) { return activo() && miDoc().rol in lista; }
    function esAdmin() { return rol(['ADMIN']); }
    function soloCambia(campos) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos); }

    // Marca de "ya se creó el administrador": se crea una sola vez
    match /config/inicio {
      allow get: if true;
      allow create: if request.auth != null && existsAfter(/databases/$(db)/documents/usuarios/$(request.auth.uid));
    }
    // Listas de los formularios y clave de IA: las lee cualquier usuario activo, solo el administrador las cambia
    match /config/listas { allow read: if activo(); allow write: if esAdmin(); }
    match /config/ia { allow read: if activo(); allow write: if esAdmin(); }
    // Correlativo de códigos de producto
    match /config/contadores { allow read, write: if rol(['ADMIN', 'LOGISTICA', 'COMPRAS', 'ALMACEN']); }

    match /usuarios/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow read, update, delete: if esAdmin();
      allow create: if esAdmin()
        // Primera vez: quien configura el sistema se crea a sí mismo como administrador
        || (request.auth != null && request.auth.uid == uid
            && request.resource.data.rol == 'ADMIN'
            && !exists(/databases/$(db)/documents/config/inicio)
            && existsAfter(/databases/$(db)/documents/config/inicio));
    }

    // Facturas de servicios y de compras
    match /comprobantes/{id} {
      allow read: if activo();
      allow create: if rol(['ADMIN', 'LOGISTICA', 'COMPRAS']);
      allow update: if rol(['ADMIN', 'LOGISTICA', 'COMPRAS'])
        || (rol(['GERENCIA']) && soloCambia(['aprobacion']));
      allow delete: if esAdmin();
    }
    // Fotos o PDF de los comprobantes (reducidos en el navegador)
    match /adjuntos/{id} {
      allow read: if activo();
      allow create: if rol(['ADMIN', 'LOGISTICA', 'COMPRAS'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.d is string && request.resource.data.d.size() < 1000000;
      allow delete: if esAdmin() || (activo() && resource.data.uid == request.auth.uid);
    }
    match /proveedores/{ruc} {
      allow read: if activo();
      allow write: if rol(['ADMIN', 'LOGISTICA', 'COMPRAS']);
    }

    // Kardex
    match /productos/{id} {
      allow read: if activo();
      allow create, update: if rol(['ADMIN', 'LOGISTICA', 'COMPRAS', 'ALMACEN']);
      allow delete: if esAdmin();
    }
    match /movimientos/{id} {
      allow read: if activo();
      allow create: if rol(['ADMIN', 'LOGISTICA', 'COMPRAS', 'ALMACEN']);
      allow update, delete: if esAdmin(); // solo el administrador corrige o elimina movimientos
    }

    // Solicitudes de materiales de las sucursales (página pública solicitud.html, sin usuario ni contraseña)
    // Catálogo público: solo nombres de materiales y de sucursales (sin stock ni costos)
    match /publico/catalogo {
      allow get: if true;
      allow write: if rol(['ADMIN', 'LOGISTICA', 'COMPRAS', 'ALMACEN']);
    }
    // Correlativo de solicitudes: solo puede subir de uno en uno
    match /publico/contador {
      allow get: if true;
      allow create: if request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == 1;
      allow update: if request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == resource.data.n + 1;
    }
    match /solicitudes/{id} {
      allow get: if true; // la sucursal consulta el estado de lo que envió (necesita el id)
      allow list: if activo();
      allow create: if request.resource.data.keys().hasOnly(['numero', 'tipo', 'fecha', 'mes', 'centro', 'centroNombre', 'solicitante', 'nota', 'items', 'estado', 'creadoMs', 'creado'])
        && request.resource.data.estado == 'PENDIENTE'
        && (!('tipo' in request.resource.data) || request.resource.data.tipo in ['ESCRITORIO', 'LIMPIEZA'])
        && request.resource.data.items is list && request.resource.data.items.size() > 0 && request.resource.data.items.size() <= 40
        && request.resource.data.solicitante is string && request.resource.data.solicitante.size() > 2 && request.resource.data.solicitante.size() <= 80
        && request.resource.data.centro is string && request.resource.data.centro.size() > 0 && request.resource.data.centro.size() <= 60
        && request.resource.data.nota is string && request.resource.data.nota.size() <= 200
        && request.resource.data.numero == getAfter(/databases/$(db)/documents/publico/contador).data.n;
      allow update: if rol(['ADMIN', 'LOGISTICA', 'COMPRAS', 'ALMACEN']);
      allow delete: if esAdmin();
    }

    // Personal
    match /personal/{dni} {
      allow read: if activo();
      allow write: if rol(['ADMIN', 'RRHH']);
    }
  }
}
